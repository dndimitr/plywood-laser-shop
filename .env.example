# Local fallback: leave DATABASE_URL empty to use data/local-db.json
DATABASE_URL=""
DIRECT_URL=""

# Neon (production):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-long-random-string"
ADMIN_EMAIL="admin@plywood.local"
ADMIN_PASSWORD="admin123"
ADMIN_NOTIFY_EMAIL="admin@plywood.local"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_PHONE="0888123456"

# SEO / Analytics / Google Ads (optional — leave empty to disable tags)
# Production: set NEXT_PUBLIC_APP_URL to your canonical https domain
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
# Conversion label from Google Ads (label only, or full AW-XXX/label)
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL="AbCdEfGhIjKlMnOp"
# Prefer GTM if you manage all tags there (then GA/Ads IDs can live in GTM)
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# Search Console HTML tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-token"

# Optional email (Resend)
# RESEND_API_KEY=""
# EMAIL_FROM="ЛазерШперплат <orders@yourdomain.com>"

# Optional Stripe
# STRIPE_SECRET_KEY=""

# Optional Blob
# BLOB_READ_WRITE_TOKEN=""

# Bank transfer details
BANK_BENEFICIARY="ЛазерШперплат ЕООД"
BANK_IBAN="BG00XXXX00000000000000"
BANK_BIC="XXXXBGSF"
BANK_NAME="Примерна банка"
BANK_REASON_PREFIX="Поръчка"
