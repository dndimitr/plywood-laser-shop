# Local fallback: leave DATABASE_URL empty to use data/local-db.json
DATABASE_URL=""
DIRECT_URL=""

# Neon (production):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-long-random-string"
ADMIN_EMAIL="admin@plywood.local"
ADMIN_PASSWORD="admin123"
ADMIN_NOTIFY_EMAIL="admin@plywood.local"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_PHONE="+359 883 44 33 61"
NEXT_PUBLIC_SHOP_ADDRESS="гр. Варна, жк. Възраждане 4, № 76"

# SEO / Analytics / Google Ads / Meta (optional — also editable in Admin → Маркетинг)
# Production (Vercel): MUST be https://studiobreza.eu — wrong host breaks Facebook
# Open Graph previews (share button opens Facebook with empty title/image).
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL="AbCdEfGhIjKlMnOp"
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-token"
NEXT_PUBLIC_META_PIXEL_ID="1528087985751399"
# Server-side Meta Conversions API + Dataset Quality API (Events Manager token).
# Generate with "Set up with Dataset Quality API" so the same token can send CAPI
# events and read EMQ / event coverage. Required on Vercel Production + Preview.
# META_CAPI_ACCESS_TOKEN=""
# META_CAPI_TEST_EVENT_CODE=""
# NEXT_PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/your-page"

# Optional email (Resend)
# RESEND_API_KEY=""
# EMAIL_FROM="ЛазерШперплат <orders@yourdomain.com>"

# Optional Stripe
# STRIPE_SECRET_KEY=""

# Optional Blob
# BLOB_READ_WRITE_TOKEN=""

# Bank transfer details
BANK_BENEFICIARY="ЛазерШперплат ЕООД"
BANK_IBAN="BG00XXXX00000000000000"
BANK_BIC="XXXXBGSF"
BANK_NAME="Примерна банка"
